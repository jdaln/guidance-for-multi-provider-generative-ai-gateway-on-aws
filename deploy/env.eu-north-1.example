# Example .env for the Stockholm (eu-north-1) deployment of this fork.
# Copy to .env at the repository root and fill in the values marked <...>.
# .env is git-ignored; never commit it (it contains your allow-list IPs and, later, keys).

# ---- Versions / images
LITELLM_VERSION="v1.100.0"
VERIFY_LITELLM_IMAGE_SIGNATURE="true"   # requires cosign on the deploying machine
BUILD_FROM_SOURCE="false"
LITELLM_LOG_LEVEL="INFO"

# ---- Platform
DEPLOYMENT_PLATFORM="ECS"
ENABLE_MIDDLEWARE="false"               # LiteLLM only; every path served by LiteLLM directly
CPU_ARCHITECTURE="x86"
ECS_VCPUS="2"
ECS_MEMORY_PER_VCPU_MIB="4096"          # 8 GiB task; LiteLLM recommends about 4 GiB per worker
DESIRED_CAPACITY="1"                    # first deploy with 1 task (schema migration runs once); raise to 2 afterwards
MIN_CAPACITY="1"
MAX_CAPACITY="4"
ECS_CPU_TARGET_UTILIZATION_PERCENTAGE="60"
ECS_MEMORY_TARGET_UTILIZATION_PERCENTAGE="70"
ALB_IDLE_TIMEOUT_SECONDS="900"

# ---- Network exposure: public ALB restricted to your client IP ranges, no CloudFront
USE_CLOUDFRONT="false"
PUBLIC_LOAD_BALANCER="true"
ALB_ALLOWED_CIDRS="<office-ip>/32,<second-ip>/32"   # comma-separated IPv4 CIDRs; applied to the security group and WAF
USE_ROUTE53="true"
HOSTED_ZONE_NAME="<your-domain.example>"           # public hosted zone in this account (Route53 registration creates it)
RECORD_NAME="gateway"                              # => https://gateway.<your-domain.example>
CERTIFICATE_ARN=""                                 # empty: an ACM certificate is requested and DNS-validated automatically
CLOUDFRONT_PRICE_CLASS="PriceClass_100"

# ---- Region specifics
EXISTING_VPC_ID=""
DISABLE_OUTBOUND_NETWORK_ACCESS="false"
CREATE_VPC_ENDPOINTS_IN_EXISTING_VPC="false"
CREATE_BEDROCK_AGENT_ENDPOINT="false"   # Agents for Bedrock is not offered in eu-north-1
CREATE_PRIVATE_HOSTED_ZONE_IN_EXISTING_VPC="false"

# ---- Guardrails (create the guardrail first, see DEPLOYMENT-RUNBOOK.md)
BEDROCK_GUARDRAIL_ID="<guardrail-id>"
BEDROCK_GUARDRAIL_VERSION="1"

# ---- Data stores
RDS_INSTANCE_CLASS="db.t3.small"
RDS_ALLOCATED_STORAGE_GB="20"
RDS_BACKUP_RETENTION_DAYS="7"
RDS_DELETION_PROTECTION="true"
RDS_LOG_STATEMENT="ddl"
REDIS_NODE_TYPE="cache.t3.micro"
REDIS_NUM_CACHE_CLUSTERS="2"

# ---- Admin surfaces
DISABLE_SWAGGER_PAGE="true"
DISABLE_ADMIN_UI="false"                # UI kept; its password is a separate secret (key UI_PASSWORD in LiteLLMMasterSalt-*)

# ---- Terraform state
TERRAFORM_S3_BUCKET_NAME="<globally-unique-bucket-name>"

# ---- Unused providers (Bedrock only). deploy.sh requires the variables to exist.
OKTA_ISSUER=""
OKTA_AUDIENCE="api://default"
OPENAI_API_KEY="placeholder"
AZURE_OPENAI_API_KEY="placeholder"
AZURE_API_KEY="placeholder"
ANTHROPIC_API_KEY="placeholder"
GROQ_API_KEY="placeholder"
COHERE_API_KEY="placeholder"
CO_API_KEY="placeholder"
HF_TOKEN="placeholder"
HUGGINGFACE_API_KEY="placeholder"
DATABRICKS_API_KEY="placeholder"
GEMINI_API_KEY="placeholder"
CODESTRAL_API_KEY="placeholder"
MISTRAL_API_KEY="placeholder"
AZURE_AI_API_KEY="placeholder"
NVIDIA_NIM_API_KEY="placeholder"
XAI_API_KEY="placeholder"
PERPLEXITYAI_API_KEY="placeholder"
GITHUB_API_KEY="placeholder"
DEEPSEEK_API_KEY="placeholder"
AI21_API_KEY="placeholder"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""
LANGSMITH_DEFAULT_RUN_NAME=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=""
EXISTING_EKS_CLUSTER_NAME=""
INSTALL_ADD_ONS_IN_EXISTING_EKS_CLUSTER="false"
EKS_ARM_INSTANCE_TYPE="t4g.medium"
EKS_X86_INSTANCE_TYPE="t3.medium"
EKS_ARM_AMI_TYPE="AL2_ARM_64"
EKS_X86_AMI_TYPE="AL2_x86_64"
EC2_KEY_PAIR_NAME=""
FAKE_LLM_LOAD_TESTING_ENDPOINT_CERTIFICATE_ARN=""
FAKE_LLM_LOAD_TESTING_ENDPOINT_HOSTED_ZONE_NAME=""
FAKE_LLM_LOAD_TESTING_ENDPOINT_RECORD_NAME=""
