{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalServicesUsedByTheStack",
      "Effect": "Allow",
      "Action": [
        "ec2:*Vpc*", "ec2:*Subnet*", "ec2:*RouteTable*", "ec2:*Route", "ec2:*InternetGateway*",
        "ec2:*NatGateway*", "ec2:*Address*", "ec2:*SecurityGroup*", "ec2:*VpcEndpoint*",
        "ec2:*FlowLogs*", "ec2:*NetworkInterface*", "ec2:*Tags", "ec2:Describe*",
        "ecs:*",
        "ecr:*",
        "elasticloadbalancing:*",
        "rds:*",
        "elasticache:*",
        "secretsmanager:*",
        "logs:*",
        "wafv2:*",
        "cloudformation:*",
        "acm:*",
        "application-autoscaling:*",
        "kms:DescribeKey", "kms:CreateGrant", "kms:ListAliases",
        "bedrock:GetGuardrail", "bedrock:ListGuardrails", "bedrock:CreateGuardrail", "bedrock:CreateGuardrailVersion",
        "bedrock:GetAccountDataRetention", "bedrock:PutAccountDataRetention",
        "bedrock:ListFoundationModels", "bedrock:GetFoundationModel", "bedrock:ListInferenceProfiles"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": ["eu-north-1"] },
        "IpAddress": { "aws:SourceIp": ["<your-ip>/32"] }
      }
    },
    {
      "Sid": "S3StateConfigAndLogBuckets",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": "*",
      "Condition": {
        "IpAddress": { "aws:SourceIp": ["<your-ip>/32"] }
      }
    },
    {
      "Sid": "GlobalServices",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "route53:ListHostedZones", "route53:ListHostedZonesByName", "route53:GetHostedZone",
        "route53:ChangeResourceRecordSets", "route53:GetChange", "route53:ListResourceRecordSets",
        "route53:ListTagsForResource",
        "iam:GetRole", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole",
        "iam:GetPolicy", "iam:GetPolicyVersion", "iam:ListPolicyVersions", "iam:ListPolicies",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": { "aws:SourceIp": ["<your-ip>/32"] }
      }
    },
    {
      "Sid": "IamRolesAndPoliciesCreatedByTheStack",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:UpdateRole", "iam:UpdateAssumeRolePolicy", "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy",
        "iam:CreatePolicy", "iam:DeletePolicy", "iam:CreatePolicyVersion", "iam:DeletePolicyVersion", "iam:TagPolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/litellm-stack-*",
        "arn:aws:iam::*:policy/litellm-stack-*"
      ],
      "Condition": {
        "IpAddress": { "aws:SourceIp": ["<your-ip>/32"] }
      }
    }
  ]
}
